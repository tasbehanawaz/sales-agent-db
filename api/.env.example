# API Server Configuration
NODE_ENV=development
API_PORT=3000
API_HOST=localhost

# API Key Authentication
# Generate a random key: node -e "console.log('sk_prod_' + require('crypto').randomBytes(24).toString('hex'))"
API_KEY=sk_prod_your_random_key_here

# MSSQL Database Configuration
# For local: DB_HOST=localhost
# For production: DB_HOST=your_mssql_server_ip
DB_HOST=your_mssql_server_ip
DB_PORT=1433
DB_NAME=sales_agent_demo
DB_NAME_MFG=manufacturing_agent_demo
DB_USER=your_database_username
DB_PASSWORD=your_database_password

# CORS Configuration
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info

# Cache GET /api responses (milliseconds). Seed data is static, so 5 minutes is safe.
CACHE_TTL_MS=300000

# Swagger / OpenAPI docs
# SWAGGER_ENABLED=false disables both the UI and the JSON endpoint.
# UI is served at SWAGGER_ROUTE, raw spec at SWAGGER_JSON_ROUTE.
# SWAGGER_SERVER_URL overrides the "servers" entry advertised in the spec
# (useful behind a reverse proxy). Defaults to http://API_HOST:API_PORT.
SWAGGER_ENABLED=true
SWAGGER_ROUTE=/docs
SWAGGER_JSON_ROUTE=/docs.json
# SWAGGER_SERVER_URL=https://api.example.com
